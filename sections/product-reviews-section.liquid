<div class="product-reviews-section-wrap section-{{ section.id }}">
  <div class="product-reviews-section-wrap__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="product-reviews-section-wrap__heading">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- render 'product-reviews', product: product -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "product-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Customer Reviews"
    },
    {
      "type": "range",
      "id": "reviews_per_page",
      "label": "Reviews per page",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
