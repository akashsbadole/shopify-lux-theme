<div class="main-register section-{{ section.id }}">
  <div class="auth-form-wrap">
    <h1 class="auth-form__title">Create Account</h1>
    {%- form 'create_customer', id: 'RegisterForm' -%}
      {%- if form.errors -%}
        <div class="auth-form__error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="auth-form__row">
        <div class="auth-form__field">
          <label for="RegFirstName">First name</label>
          <input type="text" id="RegFirstName" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="auth-form__field">
          <label for="RegLastName">Last name</label>
          <input type="text" id="RegLastName" name="customer[last_name]" autocomplete="family-name">
        </div>
      </div>
      <div class="auth-form__field">
        <label for="RegEmail">Email</label>
        <input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="auth-form__field">
        <label for="RegPassword">Password</label>
        <input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" minlength="5" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">Create Account</button>
    {%- endform -%}
    <p class="auth-form__switch">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
  </div>
</div>
{% schema %}{ "name": "Register", "tag": "section", "settings": [] }{% endschema %}
