<footer class="site-footer" role="contentinfo">
  <div class="site-footer__main">
    <div class="site-footer__inner">

      <!-- Brand column -->
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name }}">
          <div class="logo-icon" aria-hidden="true"></div>
          <span class="logo-text">{{ shop.name }}</span>
        </a>

        {%- if settings.footer_tagline != blank -%}
          <p class="site-footer__tagline">{{ settings.footer_tagline }}</p>
        {%- endif -%}

        <!-- Newsletter -->
        {%- if settings.footer_show_newsletter -%}
          {%- form 'customer', id: 'FooterNewsletterForm' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer-newsletter" role="group" aria-label="Newsletter signup">
              <label for="FooterEmail" class="visually-hidden">Email address</label>
              <input
                type="email"
                id="FooterEmail"
                name="contact[email]"
                placeholder="Your email address"
                class="footer-newsletter__input"
                required
              >
              <button type="submit" class="footer-newsletter__btn">
                {{ settings.footer_newsletter_label | default: 'Subscribe' }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="footer-newsletter__success">Thanks for subscribing!</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        <!-- Social icons -->
        <div class="footer-social">
          {%- if settings.social_instagram_url != blank -%}
            <a href="{{ settings.social_instagram_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_url != blank -%}
            <a href="{{ settings.social_facebook_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_url != blank -%}
            <a href="{{ settings.social_twitter_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="Twitter">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Menu columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="site-footer__col-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="site-footer__col-list" role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}" class="site-footer__col-link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>

  <!-- Footer bottom bar -->
  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.copyright_suffix != blank -%}
          {{ section.settings.copyright_suffix }}
        {%- else -%}
          All rights reserved.
        {%- endif -%}
      </p>

      {%- if settings.show_payment_icons -%}
        <div class="site-footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <ul class="site-footer__policy-links" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}" class="site-footer__policy-link">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "site-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "link_list", "settings": { "heading": "Help", "menu": "footer" } },
        { "type": "link_list", "settings": { "heading": "Company", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
