<div class="main-404 section-{{ section.id }}">
  <div class="main-404__inner">
    <div class="main-404__visual" aria-hidden="true">404</div>
    <h1 class="main-404__title">Page not found</h1>
    <p class="main-404__text">The page you were looking for doesn't exist. Try searching or browse our store.</p>
    <div class="main-404__actions">
      <a href="{{ routes.root_url }}" class="btn btn--primary">Go Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Shop All</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": []
}
{% endschema %}
