{%- assign collection = collections[section.settings.collection] -%}
{%- assign limit = section.settings.products_to_show | default: 12 -%}

<div class="product-carousel section-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">
  <div class="product-carousel__inner">
    <div class="product-carousel__head">
      <div class="section-header">
        {%- if section.settings.title != blank -%}
          <h2 class="section-header__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if collection != blank -%}
          <a href="{{ collection.url }}" class="section-header__link">See All <span>→</span></a>
        {%- endif -%}
      </div>
      <div class="product-carousel__controls">
        <button class="product-carousel__btn product-carousel__btn--prev" aria-label="Previous" data-carousel="{{ section.id }}">
          {%- render 'icon-arrow-left' -%}
        </button>
        <button class="product-carousel__btn product-carousel__btn--next" aria-label="Next" data-carousel="{{ section.id }}">
          {%- render 'icon-arrow-right' -%}
        </button>
      </div>
    </div>

    <div class="product-carousel__track-wrap" id="Carousel{{ section.id }}">
      <div class="product-carousel__track" id="CarouselTrack{{ section.id }}">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            <a href="{{ product.url }}" class="product-carousel__card">
              <div class="product-carousel__card-img">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 400
                    | image_tag:
                      alt: product.featured_image.alt | default: product.title,
                      loading: 'lazy',
                      width: 240,
                      height: 240
                  }}
                {%- else -%}
                  <div class="product-carousel__card-placeholder"></div>
                {%- endif -%}
              </div>
              <div class="product-carousel__card-body">
                <h3 class="product-carousel__card-title">{{ product.title | escape | truncate: 40 }}</h3>
                <p class="product-carousel__card-price">{{ product.price | money }}</p>
              </div>
            </a>
          {%- endfor -%}
          {%- comment -%} Duplicate for infinite loop {%- endcomment -%}
          {%- for product in collection.products limit: limit -%}
            <a href="{{ product.url }}" class="product-carousel__card" aria-hidden="true" tabindex="-1">
              <div class="product-carousel__card-img">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 400
                    | image_tag:
                      alt: '',
                      loading: 'lazy',
                      width: 240,
                      height: 240
                  }}
                {%- else -%}
                  <div class="product-carousel__card-placeholder"></div>
                {%- endif -%}
              </div>
              <div class="product-carousel__card-body">
                <h3 class="product-carousel__card-title">{{ product.title | escape | truncate: 40 }}</h3>
                <p class="product-carousel__card-price">{{ product.price | money }}</p>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="product-carousel__card product-carousel__card--placeholder">
              <div class="product-carousel__card-img"><div class="product-carousel__card-placeholder"></div></div>
              <div class="product-carousel__card-body">
                <div class="placeholder-text placeholder-text--sm"></div>
                <div class="placeholder-text placeholder-text--xs"></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "class": "product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Scroll speed (ms)",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}