{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

<div class="main-product section-{{ section.id }}" id="MainProduct" data-product-id="{{ product.id }}">
  <!-- Breadcrumbs -->
  <nav class="main-product__breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
        <span class="breadcrumbs__separator" aria-hidden="true">›</span>
      </li>
      {%- if collection -%}
      <li class="breadcrumbs__item">
        <a href="{{ collection.url }}" class="breadcrumbs__link">{{ collection.title }}</a>
        <span class="breadcrumbs__separator" aria-hidden="true">›</span>
      </li>
      {%- endif -%}
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current">{{ product.title | truncate: 30 }}</span>
      </li>
    </ol>
  </nav>

  <div class="main-product__inner">

    <!-- Gallery -->
    <div class="main-product__gallery" id="ProductGallery" data-media-count="{{ product.media.size }}">
      <!-- Main image area with all media -->
      <div class="product-gallery__main" id="ProductMainImage">
        {%- for media in product.media -%}
          <div 
            class="product-gallery__slide{% if media == featured_media %} product-gallery__slide--active{% endif %}{% if section.settings.enable_zoom %} product-gallery__slide--zoomable{% endif %}"
            data-media-id="{{ media.id }}"
            data-index="{{ forloop.index0 }}"
            {%- if media != featured_media -%}style="display:none;"{%- endif -%}
          >
            {%- if media.media_type == 'video' -%}
              {{ media | video_tag: image_size: '1000x', loop: true, muted: true, autoplay: false, class: 'product-gallery__video' }}
            {%- elsif media.media_type == 'model' -%}
              {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, class: 'product-gallery__model' }}
            {%- else -%}
              {%- if forloop.first -%}
              {{ media | image_url: width: 1000 | image_tag: class: 'product-gallery__img', alt: media.alt | default: product.title, loading: 'eager' }}
            {%- else -%}
              {{ media | image_url: width: 1000 | image_tag: class: 'product-gallery__img', alt: media.alt | default: product.title, loading: 'lazy' }}
            {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- if product.media.size == 0 -%}
          <div class="product-gallery__slide product-gallery__slide--active">
            <div class="product-gallery__placeholder">{%- render 'icon-image' -%}</div>
          </div>
        {%- endif -%}

        <!-- Navigation arrows -->
        {%- if product.media.size > 1 -%}
          <button class="product-gallery__nav product-gallery__nav--prev" id="GalleryPrev" aria-label="Previous image">
            {%- render 'icon-arrow-left' -%}
          </button>
          <button class="product-gallery__nav product-gallery__nav--next" id="GalleryNext" aria-label="Next image">
            {%- render 'icon-arrow-right' -%}
          </button>
        {%- endif -%}
      </div>

      <!-- Thumbnails -->
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs" id="ProductThumbs" role="list">
          {%- for media in product.media -%}
            <button
              class="product-gallery__thumb{% if media == featured_media %} product-gallery__thumb--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {%- if media.media_type == 'video' -%}
                <div class="product-gallery__thumb-video-icon">▶</div>
              {%- endif -%}
              {{ media.preview_image | image_url: width: 120 | image_tag: alt: media.alt | default: product.title, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div><!-- /.main-product__gallery -->

    <!-- Product info -->
    <div class="main-product__info">

      <!-- Vendor -->
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="main-product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <!-- Title -->
      <h1 class="main-product__title">{{ product.title }}</h1>

      <!-- Rating -->
      {%- if section.settings.show_rating -%}
        {%- if product.metafields.reviews.rating.value != blank -%}
          <div class="main-product__rating" aria-label="{{ product.metafields.reviews.rating.value }} out of 5">
            {%- assign rating_val = product.metafields.reviews.rating.value | round -%}
            {%- for i in (1..5) -%}
              <span class="product-card__star{% if i <= rating_val %} product-card__star--filled{% endif %}">★</span>
            {%- endfor -%}
            {%- if product.metafields.reviews.rating_count.value -%}
              <span class="main-product__rating-count">({{ product.metafields.reviews.rating_count.value }} reviews)</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      <!-- Price -->
      <div class="main-product__price" id="ProductPrice">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="main-product__price-sale">{{ current_variant.price | money }}</span>
          <span class="main-product__price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="main-product__price-badge">Save {{ discount_pct }}%</span>
        {%- else -%}
          <span class="main-product__price-regular">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Inventory Status -->
      {%- if section.settings.show_inventory != false and current_variant.inventory_quantity > 0 -%}
        <div class="main-product__inventory" id="ProductInventory">
          {%- if current_variant.inventory_quantity <= 10 -%}
            <span class="main-product__inventory--low">🔥 Only {{ current_variant.inventory_quantity }} left!</span>
          {%- elsif current_variant.inventory_quantity <= 30 -%}
            <span class="main-product__inventory--medium">Fast selling - {{ current_variant.inventory_quantity }} left</span>
          {%- else -%}
            <span class="main-product__inventory--high">In Stock</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Pre-order Badge -->
      {%- if section.settings.show_preorder_badge -%}
        <div class="main-product__preorder">
          <span class="main-product__preorder-badge">📦 Pre-order</span>
          <span class="main-product__preorder-text">{{ section.settings.preorder_message }} {{ section.settings.preorder_date }}</span>
        </div>
      {%- endif -%}

      <!-- India: EMI Calculator -->
      {%- if section.settings.enable_emi != false -%}
        {%- render 'emi-calculator', price: current_variant.price -%}
      {%- endif -%}

      <!-- India: COD Badge -->
      {%- if section.settings.enable_cod != false -%}
        {%- render 'cod-badge' -%}
      {%- endif -%}

      <!-- Variants -->
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="main-product__option" data-option-index="{{ forloop.index0 }}">
            <label class="main-product__option-label">
              {{ option.name }}:
              <span class="main-product__option-selected" id="SelectedOption{{ forloop.index }}">{{ option.selected_value }}</span>
            </label>

            {%- assign option_name_lower = option.name | downcase -%}
            {%- if option_name_lower == 'size' -%}
              <button
                type="button"
                class="main-product__size-guide-btn"
                data-size-guide
                aria-controls="SizeGuideModal"
              >
                📏 Size Guide
              </button>
            {%- endif -%}
            {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
              <!-- Color swatches -->
              <div class="main-product__swatches" role="radiogroup" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  <button
                    class="main-product__swatch{% if option.selected_value == value %} main-product__swatch--active{% endif %}"
                    style="background-color: {{ value | downcase | replace: ' ', '' }};"
                    data-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    aria-label="{{ value }}"
                    title="{{ value }}"
                    role="radio"
                  ></button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <!-- Pill buttons -->
              <div class="main-product__option-values" role="radiogroup" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  <button
                    class="main-product__option-btn{% if option.selected_value == value %} main-product__option-btn--active{% endif %}"
                    data-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    role="radio"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <!-- Hidden variant selector (for form submission) -->
      {%- form 'product', product, id: 'ProductForm', novalidate: true -%}
        <input type="hidden" name="id" id="ProductVariantId" value="{{ current_variant.id }}">

        <!-- Quantity -->
        <div class="main-product__qty-wrap">
          <label class="main-product__qty-label" for="ProductQty">Quantity</label>
          <div class="main-product__qty">
            <button type="button" class="main-product__qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
            <input
              type="number"
              id="ProductQty"
              name="quantity"
              value="1"
              min="1"
              class="main-product__qty-input"
              aria-label="Quantity"
            >
            <button type="button" class="main-product__qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <!-- Add to cart -->
        <div class="main-product__atc-wrap{% unless current_variant.available %} main-product__atc-wrap--hidden{% endunless %}" id="ATCWrap">
          <button
            type="submit"
            name="add"
            class="btn btn--atc{% unless current_variant.available %} btn--disabled{% endunless %}"
            id="AddToCartBtn"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span class="btn__icon">+</span>
            <span id="AddToCartText">
              {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
            </span>
          </button>

          {%- if section.settings.enable_buy_now and current_variant.available -%}
          <button
            type="button"
            class="btn btn--buy-now"
            onclick="document.getElementById('ProductForm').submit(); window.location.href='{{ routes.cart_url }}?checkout=1';"
          >
            Buy Now
          </button>
          {%- endif -%}

          <!-- Wishlist -->
          <button
            type="button"
            class="btn btn--wishlist"
            data-product-id="{{ product.id }}"
            aria-label="Add to wishlist"
          >
            {%- render 'icon-heart' -%}
          </button>
        </div>

        <!-- Dynamic checkout (Shop Pay, Apple Pay etc.) -->
        {{ form | payment_button }}

      {%- endform -%}

      <!-- Notify Me (shown when variant is sold out) -->
      {%- render 'notify-me', product: product, variant: current_variant -%}

      <!-- Urgency Indicators -->
      {%- render 'urgency-indicators', product: product, variant: current_variant -%}

      <!-- Trust badges inline -->
      <div class="main-product__trust">
        <div class="main-product__trust-badge">🔒 Secure checkout</div>
        <div class="main-product__trust-badge">🚚 Free delivery over $99</div>
        <div class="main-product__trust-badge">↩️ 30-day returns</div>
      </div>

      <!-- Loyalty Points -->
      {%- render 'loyalty-display', product: product -%}

      <!-- Description with tabs -->
      {%- if product.description != blank -%}
        <div class="main-product__desc" id="ProductDescription">
          <div class="desc-tabs">
            <button class="desc-tab desc-tab--active" data-tab="desc">Description</button>
            <button class="desc-tab" data-tab="shipping">Shipping</button>
            <button class="desc-tab" data-tab="returns">Returns</button>
          </div>
          <div class="desc-content desc-content--active" id="ProductDescBody">
            <div class="rte">
              {{ product.description }}
            </div>
            <div class="desc-features">
              {%- if product.metafields.custom.features != blank -%}
                <ul class="features-list">
                  {%- assign features = product.metafields.custom.features | split: '|' -%}
                  {%- for feature in features -%}
                    <li>✓ {{ feature }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
          <div class="desc-content" id="ShippingInfo">
            <div class="shipping-info">
              <div class="shipping-item">
                <span class="shipping-icon">🚚</span>
                <div class="shipping-details">
                  <h4>Free Shipping</h4>
                  <p>On orders above $99. Standard delivery in 5-7 business days.</p>
                </div>
              </div>
              <div class="shipping-item">
                <span class="shipping-icon">⚡</span>
                <div class="shipping-details">
                  <h4>Express Delivery</h4>
                  <p>Get it in 2-3 business days with express shipping.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="desc-content" id="ReturnsInfo">
            <div class="returns-info">
              <div class="returns-item">
                <span class="returns-icon">↩️</span>
                <div class="returns-details">
                  <h4>30-Day Returns</h4>
                  <p>Hassle-free returns within 30 days of delivery.</p>
                </div>
              </div>
              <div class="returns-item">
                <span class="returns-icon">💬</span>
                <div class="returns-details">
                  <h4>Easy Process</h4>
                  <p>Simply request a return and we'll handle the rest.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      <!-- Share (outside description, after it) -->
      {%- if settings.enable_share_buttons -%}
        <div class="main-product__share">
          <span class="main-product__share-label">Share:</span>
          {%- if settings.share_facebook -%}
            <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url | url_encode }}" target="_blank" rel="noopener" class="main-product__share-btn main-product__share-btn--fb" aria-label="Share on Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.share_twitter -%}
            <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" class="main-product__share-btn main-product__share-btn--x" aria-label="Share on X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.share_pinterest -%}
            <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url | url_encode }}&media={{ product.featured_image | image_url: width: 600 }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" class="main-product__share-btn main-product__share-btn--pin" aria-label="Share on Pinterest">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.share_whatsapp -%}
            <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url | url_encode }}" target="_blank" rel="noopener" class="main-product__share-btn main-product__share-btn--wa" aria-label="Share on WhatsApp">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.share_copy_link -%}
            <button type="button" class="main-product__share-btn main-product__share-btn--copy" id="ShareCopyLink" aria-label="Copy link" data-url="{{ shop.url }}{{ product.url }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Frequently Bought Together -->
      {%- if section.settings.show_fbt -%}
        {%- section 'bundle-fbt' -%}
      {%- endif -%}

    </div>
  </div>
</div>

{%- render 'sticky-atc', product: product -%}

{%- render 'size-guide', product: product -%}

<style>
  .main-product__atc-wrap { display: flex; gap: 12px; align-items: stretch; margin: 24px 0; }
  .btn--atc { flex: 1; padding: 16px 24px; font-size: 15px; font-weight: 600; background: #1a1a2e; color: #fff; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; }
  .btn--atc:hover { background: #2d2d4a; transform: translateY(-2px); }
  .btn--buy-now { flex: 1; padding: 16px 24px; font-size: 15px; font-weight: 600; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; }
  .btn--buy-now:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4); }
  .btn--wishlist { padding: 16px; background: #f5f5f5; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; color: #666; }
  .btn--wishlist:hover { background: #ffe5e5; color: #e74c3c; }
  @media (max-width: 480px) {
    .main-product__atc-wrap { flex-wrap: wrap; }
    .btn--atc, .btn--buy-now { width: 100%; flex: none; }
  }
  .main-product__share { display: flex; align-items: center; gap: 10px; margin: 20px 0; padding: 16px 0; border-top: 1px solid var(--color-border); }
  .main-product__share-label { font-size: 14px; font-weight: 500; color: var(--color-navy); }
  .main-product__share-btn { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--color-border); color: var(--color-navy); transition: all 0.2s; text-decoration: none; }
  .main-product__share-btn:hover { transform: translateY(-2px); }
  .main-product__share-btn--fb:hover { background: #1877F2; color: #fff; border-color: #1877F2; }
  .main-product__share-btn--x:hover { background: #000; color: #fff; border-color: #000; }
  .main-product__share-btn--pin:hover { background: #E60023; color: #fff; border-color: #E60023; }
  .main-product__share-btn--wa:hover { background: #25D366; color: #fff; border-color: #25D366; }
  .main-product__share-btn--copy:hover { background: var(--color-purple); color: #fff; border-color: var(--color-purple); }
  .main-product__share-btn--copy.copied { background: #28a745; color: #fff; border-color: #28a745; }
  .main-product__preorder { margin: 12px 0; padding: 12px; background: #fef3cd; border: 1px solid #ffc107; border-radius: 8px; }
  .main-product__preorder-badge { display: inline-block; padding: 4px 10px; background: #ffc107; color: #000; font-size: 12px; font-weight: 600; border-radius: 4px; margin-right: 8px; }
  .main-product__preorder-text { font-size: 14px; color: #856404; }
</style>

<script>
  // Expose variant data for JS
  window.__luxe_variants__ = {{ product.variants | json }};

  // Variant switching & gallery sync
  document.addEventListener('DOMContentLoaded', function() {
    var productData = {{ product.variants | json }};
    var options = document.querySelectorAll('[data-option-index]');
    var variantInput = document.getElementById('ProductVariantId');
    var priceEl = document.getElementById('ProductPrice');
    var addBtn = document.getElementById('AddToCartBtn');
    var addBtnText = document.getElementById('AddToCartText');

    options.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!this.dataset.value) return;
        var idx = parseInt(this.dataset.optionIndex);
        var val = this.dataset.value;

        // Update active state
        var siblings = document.querySelectorAll('[data-option-index="' + idx + '"]');
        siblings.forEach(function(s) { s.classList.remove('main-product__swatch--active', 'main-product__option-btn--active'); s.setAttribute('aria-checked', 'false'); });
        this.classList.add(this.classList.contains('main-product__swatch') ? 'main-product__swatch--active' : 'main-product__option-btn--active');
        this.setAttribute('aria-checked', 'true');

        // Update label
        var label = document.getElementById('SelectedOption' + (idx + 1));
        if (label) label.textContent = val;

        // Find matching variant
        luxeFindVariant(productData, variantInput, priceEl, addBtn, addBtnText);
      });
    });

    // Qty controls
    var qtyInput = document.getElementById('ProductQty');
    document.querySelectorAll('.main-product__qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var delta = this.dataset.action === 'increase' ? 1 : -1;
        var val = Math.max(1, parseInt(qtyInput.value || 1) + delta);
        qtyInput.value = val;
      });
    });

    // Share copy link
    var copyBtn = document.getElementById('ShareCopyLink');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var url = this.dataset.url || window.location.href;
        navigator.clipboard.writeText(url).then(function() {
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
          setTimeout(function() {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
          }, 2000);
        });
      });
    }

    // Gallery navigation
    var gallery = document.getElementById('ProductGallery');
    var thumbs = document.querySelectorAll('.product-gallery__thumb');
    var prevBtn = document.getElementById('GalleryPrev');
    var nextBtn = document.getElementById('GalleryNext');
    var slides = gallery.querySelectorAll('.product-gallery__slide');
    var currentIndex = 0;

    function updateGallery(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      // Update active thumbnail
      thumbs.forEach(function(t, i) {
        t.classList.toggle('product-gallery__thumb--active', i === index);
      });

      // Show/hide slides
      slides.forEach(function(slide, i) {
        if (i === index) {
          slide.classList.add('product-gallery__slide--active');
          slide.style.display = '';
        } else {
          slide.classList.remove('product-gallery__slide--active');
          slide.style.display = 'none';
        }
      });
    }

    // Thumbnail click
    thumbs.forEach(function(thumb, index) {
      thumb.addEventListener('click', function() {
        updateGallery(index);
      });
    });

    // Prev/Next buttons
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        updateGallery(currentIndex - 1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        updateGallery(currentIndex + 1);
      });
    }

    // Description tabs
    var descTabs = document.querySelectorAll('.desc-tab');
    var descContents = document.querySelectorAll('.desc-content');
    descTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.dataset.tab;
        
        // Update tabs
        descTabs.forEach(function(t) { t.classList.remove('desc-tab--active'); });
        this.classList.add('desc-tab--active');
        
        // Update content
        descContents.forEach(function(content) {
          content.classList.remove('desc-content--active');
          if (content.id === target + 'Info' || (target === 'desc' && content.id === 'ProductDescBody')) {
            content.classList.add('desc-content--active');
          }
        });
      });
    });

    // Write Review Form
    var writeReviewBtn = document.getElementById('WriteReviewBtn');
    var writeReviewForm = document.getElementById('WriteReviewForm');
    var cancelReviewBtn = document.getElementById('CancelReviewBtn');
    var reviewStars = document.querySelectorAll('.review-form__star');
    var reviewRating = document.getElementById('ReviewRating');
    var reviewForm = document.getElementById('ReviewForm');

    if (writeReviewBtn && writeReviewForm) {
      writeReviewBtn.addEventListener('click', function() {
        writeReviewForm.hidden = false;
        writeReviewBtn.hidden = true;
      });

      if (cancelReviewBtn) {
        cancelReviewBtn.addEventListener('click', function() {
          writeReviewForm.hidden = true;
          writeReviewBtn.hidden = false;
        });
      }

      reviewStars.forEach(function(star) {
        star.addEventListener('click', function() {
          var rating = parseInt(this.dataset.rating);
          reviewRating.value = rating;
          reviewStars.forEach(function(s, i) {
            s.classList.toggle('active', i < rating);
          });
        });
      });

      if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var name = document.getElementById('ReviewerName').value;
          var rating = document.getElementById('ReviewRating').value;
          var title = document.getElementById('ReviewTitle').value;
          var body = document.getElementById('ReviewBody').value;
          
          alert('Thank you for your review! In a real store, this would be saved to your reviews app (Judge.me, Yotpo, etc.).\n\nName: ' + name + '\nRating: ' + rating + '/5\nTitle: ' + title);
          
          writeReviewForm.hidden = true;
          writeReviewBtn.hidden = false;
          reviewForm.reset();
          reviewStars.forEach(function(s) { s.classList.remove('active'); });
        });
      }
    }
  });

  function luxeFindVariant(variants, input, priceEl, btn, btnText) {
    var selectedOptions = [];
    document.querySelectorAll('[data-option-index]').forEach(function(el) {
      if (el.getAttribute('aria-checked') === 'true' || el.classList.contains('main-product__swatch--active') || el.classList.contains('main-product__option-btn--active')) {
        selectedOptions[parseInt(el.dataset.optionIndex)] = el.dataset.value;
      }
    });

    var match = variants.find(function(v) {
      return v.options.every(function(opt, i) { return opt === selectedOptions[i]; });
    });

    if (match) {
      input.value = match.id;
      if (priceEl) priceEl.querySelector('.main-product__price-regular, .main-product__price-sale').textContent = luxeFormatMoney(match.price);
      if (btn) {
        btn.disabled = !match.available;
        btn.classList.toggle('btn--disabled', !match.available);
      }
      if (btnText) btnText.textContent = match.available ? 'Add to Cart' : 'Sold Out';
    }
  }

  function luxeFormatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }
</script>

