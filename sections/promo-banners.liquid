{%- style -%}
  .promo-banners {
    padding: {{ section.settings.padding_y }}px 20px;
    background: {{ section.settings.bg_color }};
  }
  .promo-banners__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  .promo-banner {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    background: {{ section.settings.card_bg }};
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .promo-banner:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }
  .promo-banner__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .promo-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.overlay_color }};
    z-index: 1;
  }
  .promo-banner__content {
    position: relative;
    z-index: 2;
    padding: {{ section.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.text_align }};
    min-height: {{ section.settings.min_height }}px;
  }
  .promo-banner__tag {
    display: inline-block;
    font-size: {{ section.settings.tag_size }}px;
    font-weight: 600;
    color: {{ section.settings.tag_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .promo-banner__title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .promo-banner__text {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    line-height: 1.5;
  }
  .promo-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: {{ section.settings.btn_size }}px;
    font-weight: 600;
    color: {{ section.settings.btn_color }};
    text-decoration: none;
  }
  .promo-banner__btn svg {
    transition: transform 0.3s ease;
  }
  .promo-banner:hover .promo-banner__btn svg {
    transform: translateX(4px);
  }
  @media (max-width: 768px) {
    .promo-banners__inner {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="promo-banners" id="PromoBanners">
  <div class="promo-banners__inner">
    {%- for i in (1..4) -%}
      {%- assign banner_enabled = 'banner_' | append: i | append: '_enable' -%}
      {%- assign banner_title = 'banner_' | append: i | append: '_title' -%}
      {%- assign banner_text = 'banner_' | append: i | append: '_text' -%}
      {%- assign banner_tag = 'banner_' | append: i | append: '_tag' -%}
      {%- assign banner_image = 'banner_' | append: i | append: '_image' -%}
      {%- assign banner_link = 'banner_' | append: i | append: '_link' -%}
      
      {%- if section.settings[banner_enabled] -%}
        <a href="{{ section.settings[banner_link] | default: '#' }}" class="promo-banner">
          {%- if section.settings[banner_image] != blank -%}
            {{ section.settings[banner_image] | image_url: width: 600 | image_tag: class: 'promo-banner__img', loading: 'lazy' }}
            <div class="promo-banner__overlay"></div>
          {%- endif -%}
          <div class="promo-banner__content">
            {%- if section.settings[banner_tag] != blank -%}
              <span class="promo-banner__tag">{{ section.settings[banner_tag] }}</span>
            {%- endif -%}
            {%- if section.settings[banner_title] != blank -%}
              <h3 class="promo-banner__title">{{ section.settings[banner_title] }}</h3>
            {%- endif -%}
            {%- if section.settings[banner_text] != blank -%}
              <p class="promo-banner__text">{{ section.settings[banner_text] }}</p>
            {%- endif -%}
            <span class="promo-banner__btn">
              Shop Now
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

