{
  "name": "luxe-theme",
  "version": "1.0.0",
  "description": "Luxe Shopify Theme",
  "scripts": {
    "dev": "npm run build && shopify theme watch",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "deploy": "shopify theme deploy",
    "push": "shopify theme push",
    "pull": "shopify theme pull",
    "lint": "eslint src/javascript --ext .js && stylelint src/styles/**/*.scss",
    "lint:js": "eslint src/javascript --ext .js",
    "lint:css": "stylelint src/styles/**/*.scss"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@shopify/cli": "^3.0.0",
    "@shopify/theme": "^3.0.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.57.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
