<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, height=device-height">
  <meta name="theme-color" content="{{ settings.color_brand_blue }}">

  
  <!-- Performance: Resource Hints -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  <!-- Performance: Preload critical CSS -->
  {{ 'google-fonts.css' | asset_url | stylesheet_tag: preload: true }}

  <!-- Security: Content Security Policy (basic - Shopify handles most) -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Robots -->
  {%- if template.directory == 'customers' -%}
    <meta name="robots" content="noindex">
  {%- else -%}
    <meta name="robots" content="index,follow">
  {%- endif -%}

  <!-- Geo Tags -->
  <meta name="geo.region" content="{{ shop.address.country_code }}">
  <meta name="geo.placename" content="{{ shop.address.city }}">
  {%- if shop.phone -%}
    <meta name="contact" content="{{ shop.phone }}">
  {%- endif -%}

  <!-- Shopify required tags -->
  {{ content_for_header }}


  <!-- Loox Reviews Integration (Alternative) -->
  {%- if template == 'product' -%}
    {%- if settings.loox_app_id != blank -%}
      <script>
        !function (o, t, e, a) {
          o._Loox = o._Loox || [];
          var i = t.createElement(e);
          i.async = !0, i.crossorigin = "anonymous", i.src = a;
          var c = t.getElementsByTagName(e)[0];
          c.parentNode.insertBefore(i, c);
        }(window, document, "script", "//cdn.loox.io/widget.js");
      </script>
      <script>
        window.LooxSettings = { appId: "{{ settings.loox_app_id }}" };
      </script>
    {%- endif -%}
  {%- endif -%}

  <!-- Yotpo Reviews Integration (Alternative) -->
  {%- if template == 'product' -%}
    {%- if settings.yotpo_app_key != blank -%}
      <script>
        (function(){function a(){var a=document.createElement("script");a.type="text/javascript",a.async=!0,a.src=("https:"==document.location.protocol?"https://":"http://")+"static.yotpo.com/widget/"+b+"/widget.js";var b="{{ settings.yotpo_app_key }}";var c=document.getElementsByTagName("script")[0];c.parentNode.insertBefore(a,c)}window.addEventListener?window.addEventListener("load",a,!1):window.attachEvent("onload",a)})();
      </script>
    {%- endif -%}
  {%- endif -%}

  <!-- PWA Manifest -->
  <link rel="manifest" href="{{ 'manifest.json' | asset_url }}" crossorigin="use-credentials">

  <!-- Critical CSS inlined for faster first paint -->
  <style>
    :root {
      --color-bg: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-blue: {{ settings.color_brand_blue }};
      --color-purple: {{ settings.color_accent_purple }};
      --color-muted: {{ settings.color_muted }};
      --color-border: {{ settings.color_border }};
      --font-size-base: {{ settings.font_size_base }}px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--color-bg); color: var(--color-navy); }
    .site-header { position: relative; }
    .luxe-main { min-height: 60vh; }
  </style>

  <!-- LUXE Theme CSS -->
  {{ 'luxe-theme.css' | asset_url | stylesheet_tag }}
  {{ 'luxe-marketing.css' | asset_url | stylesheet_tag }}

  <!-- SEO: Schema.org Structured Data -->
  {%- render 'structured-data' -%}
</head>

<body class="luxe-body{% if request.page_type == 'index' %} page-home{% endif %}">

  <!-- Cookie Consent Banner (GDPR) -->
  {%- render 'cookie_consent' -%}

  <!-- Skip to content for accessibility -->
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  <!-- Announcement Bar -->
  {%- if settings.show_announcement and settings.announcement_text != blank -%}
    {%- render 'announcement-bar' -%}
  {%- endif -%}

  <!-- Header / Navbar -->
  {%- section 'header' -%}

  <!-- Main Content -->
  <main id="MainContent" class="luxe-main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Cart Drawer -->
  {%- render 'cart-drawer' -%}

  <!-- Wishlist Drawer -->
  {%- render 'wishlist-drawer' -%}

  <!-- Product Compare Drawer -->
  {%- render 'product-compare' -%}

  <!-- Quick View Modal -->
  {%- render 'quick-view' -%}

  <!-- India: Pincode Checker -->
  {%- if settings.enable_pincode_checker -%}
    <div class="pincode-checker-container">
      <button type="button" class="pincode-checker-toggle" id="PincodeCheckerToggle" aria-expanded="false" aria-controls="PincodeCheckerWidget">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{% if settings.pincode_placeholder %}{{ settings.pincode_placeholder }}{% else %}Check Delivery{% endif %}</span>
      </button>
      <div class="pincode-checker-widget" id="PincodeCheckerWidget" hidden>
        {%- render 'pincode-checker' -%}
        <button type="button" class="pincode-checker-close" id="PincodeCheckerClose" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var toggle = document.getElementById('PincodeCheckerToggle');
        var widget = document.getElementById('PincodeCheckerWidget');
        var close = document.getElementById('PincodeCheckerClose');
        if (toggle && widget) {
          toggle.addEventListener('click', function() {
            var expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', !expanded);
            widget.hidden = expanded;
          });
          if (close) {
            close.addEventListener('click', function() {
              toggle.setAttribute('aria-expanded', 'false');
              widget.hidden = true;
            });
          }
        }
      });
    </script>
  {%- endif -%}

  <!-- Floating: WhatsApp + Back to Top -->
  {%- if settings.enable_whatsapp -%}
  <div class="floating-buttons" id="FloatingButtons">
    <a href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '+' }}?text={{ settings.whatsapp_message | url_encode }}" class="floating-btn floating-btn--whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
    <button class="floating-btn floating-btn--scroll" id="ScrollToTopFloating" aria-label="Back to top">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>
  </div>
  {%- endif -%}

  <!-- Footer -->
  {%- section 'footer' -%}

  <!-- Toast Notification -->
  <div class="luxe-toast" id="luxeToast" role="status" aria-live="polite">
    <span class="luxe-toast__icon">✓</span>
    <span class="luxe-toast__msg" id="luxeToastMsg"></span>
  </div>

    <!-- Theme Settings JS -->
    {%- render 'theme-settings' -%}

    <!-- Currency Converter (optional tooltip) -->
    <script src="{{ 'currency-converter.js' | asset_url }}" defer></script>

    <!-- LUXE Theme JS -->
    <script src="{{ 'luxe-theme.js' | asset_url }}" defer="defer"></script>

    <!-- Scroll Animation Trigger -->
  <script>
    (function() {
      var animated = false;
      function animateOnScroll() {
        if (animated) return;
        var elements = document.querySelectorAll('.animate-on-scroll');
        var len = elements.length;
        for (var i = 0; i < len; i++) {
          var el = elements[i];
          var rect = el.getBoundingClientRect();
          var winH = window.innerHeight;
          if (rect.top < winH - 100) {
            el.classList.add('animated');
            el.classList.remove('animate-on-scroll');
          }
        }
        if (document.querySelectorAll('.animate-on-scroll').length === 0) {
          animated = true;
        }
      }
      window.addEventListener('scroll', animateOnScroll);
      document.addEventListener('DOMContentLoaded', animateOnScroll);
    })();
  </script>

  <!-- Tab Title - Shows custom message when user leaves tab -->
  <script>
    (function() {
      var originalTitle = document.title;
      var awayTitle = "😮 Come back! Don't miss our deals!";
      var isAway = false;
      var interval;

      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          isAway = true;
          interval = setTimeout(function() {
            document.title = awayTitle;
          }, 2000);
        } else {
          isAway = false;
          clearTimeout(interval);
          document.title = originalTitle;
        }
      });

      document.addEventListener('blur', function() {
        if (!document.hidden) {
          interval = setTimeout(function() {
            if (!document.hasFocus()) {
              document.title = awayTitle;
            }
          }, 2000);
        }
      });

      document.addEventListener('focus', function() {
        clearTimeout(interval);
        document.title = originalTitle;
      });
    })();
  </script>
</body>
</html>
