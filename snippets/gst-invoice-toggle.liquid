{%- comment -%}
  GST Invoice Toggle
  Checkbox at checkout to add GSTIN for B2B buyers.
  Adds GST number to order notes.
  Usage: {% render 'gst-invoice-toggle' %}
{%- endcomment -%}

{%- if settings.enable_gst_toggle != false -%}
<div class="gst-invoice" id="GSTInvoice">
  <label class="gst-invoice__checkbox-wrap">
    <input type="checkbox" class="gst-invoice__check" id="GSTCheck">
    <span class="gst-invoice__icon">🏢</span>
    <span class="gst-invoice__text">
      <strong>{{ settings.gst_label | default: 'Request GST Invoice' }}</strong>
      <span class="gst-invoice__subtext">{{ settings.gst_sublabel | default: 'Add GSTIN for business purchase' }}</span>
    </span>
  </label>

  <div class="gst-invoice__form" id="GSTForm" hidden>
    <div class="gst-invoice__fields">
      <div class="gst-invoice__field">
        <label for="GSTCompanyName" class="gst-invoice__label">Company Name</label>
        <input type="text" id="GSTCompanyName" class="gst-invoice__input" placeholder="Company name as per GSTIN">
      </div>
      
      <div class="gst-invoice__field">
        <label for="GSTNumber" class="gst-invoice__label">GSTIN / GST Number</label>
        <input type="text" id="GSTNumber" class="gst-invoice__input" placeholder="15 digit GSTIN (e.g., 07AAPFU1234A1Z5)" maxlength="15">
        <small class="gst-invoice__hint">Format: 15 characters (e.g., 07AAPFU1234A1Z5)</small>
      </div>
      
      <div class="gst-invoice__field">
        <label for="GSTAddress" class="gst-invoice__label">Registered Address (optional)</label>
        <textarea id="GSTAddress" class="gst-invoice__input gst-invoice__textarea" placeholder="Registered business address" rows="2"></textarea>
      </div>
    </div>
    
    <div class="gst-invoice__summary">
      <p><strong>Invoice will include:</strong></p>
      <ul>
        <li>✅ Company name & GSTIN</li>
        <li>✅ HSN codes</li>
        <li>✅ Tax breakdown (CGST/SGST or IGST)</li>
        <li>✅ Business address</li>
      </ul>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var check = document.getElementById('GSTCheck');
    var form = document.getElementById('GSTForm');
    var gstInput = document.getElementById('GSTNumber');

    if (check && form) {
      check.addEventListener('change', function() {
        form.hidden = !this.checked;
      });
    }

    if (gstInput) {
      gstInput.addEventListener('input', function() {
        this.value = this.value.toUpperCase().replace(/[^0-9A-Z]/g, '').slice(0, 15);
      });

      gstInput.addEventListener('blur', function() {
        var gstin = this.value;
        var valid = /^[0-9]{2}[A-Z]{3}[A-Z0-9]{10}$/.test(gstin);
        if (gstin && !valid) {
          this.setCustomValidity('Please enter a valid 15-character GSTIN');
        } else {
          this.setCustomValidity('');
        }
      });
    }
  });
</script>
{%- endif -%}