{%- comment -%}
  Theme Settings for JavaScript
{%- endcomment -%}
<script>
window.LuxeThemeSettings = {
  enable_currency_converter: {{ settings.enable_currency_converter | default: false | json }},
  exchange_rate_api_key: {{ settings.exchange_rate_api_key | default: '' | json }},
  converter_base_currency: {{ settings.converter_base_currency | default: 'USD' | json }},
  page_currency: {{ localization.currency.iso_code | default: 'USD' | json }},
  selected_currency: {{ localization.currency.iso_code | default: 'USD' | json }},
  promo_enabled: {{ settings.promo_enabled | default: true | json }},
  promo_priority: {{ settings.promo_priority | default: 'bogo' | json }},
  promo_show_badges: {{ settings.promo_show_badges | default: true | json }},
  promo_show_progress_bar: {{ settings.promo_show_progress_bar | default: true | json }},
  promo_enable_popups: {{ settings.promo_enable_popups | default: true | json }},
  promo_popup_trigger: {{ settings.promo_popup_trigger | default: 'exit_intent' | json }},
  promo_gift_threshold_message: {{ settings.promo_gift_threshold_message | default: 'Free gift!' | json }},
  promo_gift_modal_title: {{ settings.promo_gift_modal_title | default: 'Free Gift' | json }},
  promo_bogo_label: {{ settings.promo_bogo_label | default: 'BOGO' | json }},
  promo_volume_table_label: {{ settings.promo_volume_table_label | default: 'Bulk Pricing' | json }}
};
</script>