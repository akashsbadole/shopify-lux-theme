{%- comment -%}
  Product Reviews Section
  Supports: Judge.me, Yotpo, Loox, or native Shopify reviews
  Usage: {% render 'product-reviews', product: product %}
{%- endcomment -%}

<!-- Judge.me Widget (loads if app installed) -->
<div id="judge_me_widget"></div>

{%- liquid
  assign rating_val = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign review_list = product.metafields.reviews.reviews.value
-%}

{%- if rating_val == blank and review_list == blank -%}
  <div class="reviews-fallback">
    <div class="reviews-fallback__header">
      <h3>Customer Reviews</h3>
      <div class="reviews-fallback__stars">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <p class="reviews-fallback__count">No reviews yet</p>
    </div>
    <div class="reviews-fallback__action">
      <p>Be the first to share your experience!</p>
      <button type="button" class="btn btn--primary" onclick="document.getElementById('judge_me_widget').scrollIntoView({behavior:'smooth'})">Write a Review</button>
    </div>
  </div>

  <style>
    .reviews-fallback { text-align: center; padding: 40px 20px; background: #f9fafb; border-radius: var(--radius-lg); margin: 40px 0; }
    .reviews-fallback__header h3 { font-size: 24px; margin-bottom: 12px; }
    .reviews-fallback__stars { font-size: 24px; color: #FFB800; margin-bottom: 8px; }
    .reviews-fallback__count { color: var(--color-muted); margin-bottom: 20px; }
    .reviews-fallback__action p { color: var(--color-muted); margin-bottom: 16px; }
  </style>
{%- endif -%}

<!-- Judge.me automatically injects reviews here if installed -->
