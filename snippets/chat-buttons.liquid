{%- comment -%}
   Multi-Channel Chat Buttons
   Shows WhatsApp, Telegram, or custom chat widget
   Usage: {% render 'chat-buttons' %}
   Note: This snippet is intentionally designed to be included conditionally via JavaScript
   based on merchant settings for chat widget enablement.
{%- endcomment -%}

{%- assign chat_position = settings.chat_button_position | default: 'bottom-right' -%}

{%- if settings.enable_whatsapp or settings.enable_telegram or settings.enable_custom_chat -%}
<div class="chat-buttons chat-buttons--{{ chat_position }}" id="ChatButtons">
  {%- if settings.enable_whatsapp -%}
  {%- assign wa_number = settings.whatsapp_number | default: '919999999999' -%}
  {%- assign wa_message = settings.whatsapp_message | default: 'Hi! I\'m interested in' -%}
  {%- assign wa_product = product.title | default: '' -%}
  <a 
    href="https://wa.me/{{ wa_number }}?text={{ wa_message | url_encode }}%20{{ wa_product | url_encode }}" 
    class="chat-btn chat-btn--whatsapp" 
    target="_blank" 
    rel="noopener"
    aria-label="Chat on WhatsApp"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    {%- if settings.show_whatsapp_label -%}
    <span class="chat-btn__label">{{ settings.whatsapp_label | default: 'Chat with us' }}</span>
    {%- endif -%}
  </a>
  {%- endif -%}

  {%- if settings.enable_telegram -%}
  <a 
    href="https://t.me/{{ settings.telegram_username | default: 'yourstore' }}" 
    class="chat-btn chat-btn--telegram" 
    target="_blank" 
    rel="noopener"
    aria-label="Chat on Telegram"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18 1.897-.962 6.502-1.359 8.627-.168.9-.5 1.201-.82 1.23-.696.064-1.225-.46-1.901-.903-1.056-.693-1.653-1.124-2.678-1.8-1.185-.783-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
    </svg>
    <span class="chat-btn__label">Telegram</span>
  </a>
  {%- endif -%}
</div>

<style>
.chat-buttons {
  position: fixed;
  bottom: 24px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.chat-buttons--bottom-right { right: 24px; }
.chat-buttons--bottom-left { left: 24px; }

.chat-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 50px;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  transition: all 0.3s ease;
  font-weight: 500;
  font-size: 14px;
}
.chat-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 25px rgba(0,0,0,0.2);
}

.chat-btn--whatsapp {
  background: #25D366;
  color: white;
}
.chat-btn--whatsapp:hover {
  background: #128C7E;
}

.chat-btn--telegram {
  background: #0088cc;
  color: white;
}
.chat-btn--telegram:hover {
  background: #006699;
}

.chat-btn__label {
  white-space: nowrap;
}

@media (max-width: 480px) {
  .chat-buttons--bottom-right,
  .chat-buttons--bottom-left {
    right: 16px;
    left: 16px;
  }
  .chat-buttons {
    flex-direction: row;
    justify-content: center;
  }
  .chat-btn {
    padding: 12px;
  }
  .chat-btn__label {
    display: none;
  }
}
</style>

{%- endif -%}

{%- if settings.enable_custom_chat and settings.custom_chat_script != blank -%}
<script>
{{ settings.custom_chat_script }}
</script>
{%- endif -%}