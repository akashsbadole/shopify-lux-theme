{%- comment -%}
  Related Articles - Shows related blog posts based on tags
  Usage: {% render 'related-articles', article: article, blog: blog %}
{%- endcomment -%}

{%- if article and blog.articles.size > 1 -%}
  {%- assign current_tags = article.tags -%}
  {%- assign related_articles = '' -%}

  {%- for a in blog.articles -%}
    {%- if a.id != article.id -%}
      {%- for tag in a.tags -%}
        {%- if current_tags contains tag -%}
          {%- unless related_articles contains a.id -%}
            {%- assign related_articles = related_articles | append: a.id | append: ',' -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign related_ids = related_articles | split: ',' | compact -%}

  {%- if related_ids.size > 0 -%}
    <div class="related-articles">
      <h3 class="related-articles__title">Related Articles</h3>
      <div class="related-articles__grid">
        {%- for id in related_ids limit: 3 -%}
          {%- for a in blog.articles -%}
            {%- if a.id == id -%}
              <a href="{{ a.url }}" class="related-article">
                {%- if a.image -%}
                  <div class="related-article__img">
                    {{ a.image | image_url: width: 300 | image_tag: alt: a.title, loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <h4 class="related-article__title">{{ a.title }}</h4>
                <time class="related-article__date">{{ a.published_at | date: format: 'month_day_year' }}</time>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <style>
      .related-articles { margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--color-border); }
      .related-articles__title { font-size: 20px; font-weight: 700; color: var(--color-navy); margin-bottom: 24px; }
      .related-articles__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .related-article { text-decoration: none; }
      .related-article__img { margin-bottom: 12px; border-radius: var(--radius-md); overflow: hidden; }
      .related-article__img img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
      .related-article__title { font-size: 15px; font-weight: 600; color: var(--color-navy); margin-bottom: 4px; }
      .related-article__date { font-size: 12px; color: var(--color-muted); }
      @media (max-width: 768px) {
        .related-articles__grid { grid-template-columns: 1fr; }
      }
    </style>
  {%- endif -%}
{%- endif -%}