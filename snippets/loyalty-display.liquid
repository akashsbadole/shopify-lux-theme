{%- comment -%}
  Loyalty Points Display
  Shows potential points user can earn on product page and cart
  Usage: {% render 'loyalty-display', product: product %}
{%- endcomment -%}

{%- if settings.enable_loyalty -%}
{%- assign points_rate = settings.points_per_rupee | default: 1 | times: 1 -%}
{%- assign price = product.price | default: cart.total_price -%}
{%- assign potential_points = price | divided_by: 100 | times: points_rate | floor -%}

<div class="loyalty-display" id="LoyaltyDisplay">
  <div class="loyalty-display__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
  </div>
  <div class="loyalty-display__content">
    <span class="loyalty-display__title">{{ settings.loyalty_program_name | default: 'LUXE Rewards' }}</span>
    <span class="loyalty-display__points">Earn <strong>{{ potential_points }}</strong> points on this purchase</span>
    <span class="loyalty-display__redeem">{{ settings.loyalty_redeem_text | default: 'Redeem your points at checkout' }}</span>
  </div>
  <a href="{{ routes.account_url }}" class="loyalty-display__learn">Learn More</a>
</div>

<style>
.loyalty-display {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: linear-gradient(135deg, #fdfbf7 0%, #fef8e7 100%);
  border: 1px solid #f0e6d2;
  border-radius: 8px;
  margin: 12px 0;
}
.loyalty-display__icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
  border-radius: 50%;
  color: #8B6914;
  flex-shrink: 0;
}
.loyalty-display__content {
  flex: 1;
}
.loyalty-display__title {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: #8B6914;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.loyalty-display__points {
  display: block;
  font-size: 14px;
  color: var(--color-navy);
  font-weight: 500;
}
.loyalty-display__points strong {
  color: #8B6914;
}
.loyalty-display__redeem {
  display: block;
  font-size: 12px;
  color: var(--color-muted);
  margin-top: 2px;
}
.loyalty-display__learn {
  font-size: 13px;
  color: var(--color-purple);
  text-decoration: none;
  font-weight: 500;
  white-space: nowrap;
}
.loyalty-display__learn:hover {
  text-decoration: underline;
}
</style>
{%- endif -%}