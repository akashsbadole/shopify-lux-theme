  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#F7FAFC"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary text",
        "default": "#0E1D34"
      },
      {
        "type": "color",
        "id": "color_brand_blue",
        "label": "Brand Blue",
        "default": "#003B73"
      },
      {
        "type": "color",
        "id": "color_accent_purple",
        "label": "Accent Purple (CTA buttons)",
        "default": "#8A2BE2"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted / secondary text",
        "default": "#5a6a80"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#D8E1EC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 12,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 15
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
