{
  "name": "{{ shop.name }}",
  "short_name": "LUXE",
  "description": "{{ shop.description | default: 'Premium Shopping Experience' }}",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F7FAFC",
  "theme_color": "#003B73",
  "icons": [
    {
      "src": "{{ settings.favicon | image_url: width: 192 }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ settings.favicon | image_url: width: 512 }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}